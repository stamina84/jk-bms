# Shared configuration for the jk-bms / inverter systemd collectors.
#
# install.sh copies this to /etc/jk-bms/collector.env if it does not exist.
# Both services read it via `EnvironmentFile=-/etc/jk-bms/collector.env`.
# No quotes, no inline comments on value lines (systemd EnvironmentFile rules).

# MQTT broker that Telegraf consumes from (the inverter collector publishes here).
# install.sh fills this in (from the MQTT_BROKER env var or an interactive prompt).
MQTT_BROKER=__MQTT_BROKER__

# mpp-solar protocol used to talk to the inverters over serial.
# Production uses PI30. PI30MAX is also valid for some Easun units.
PROTOCOL=PI30

# JK-BMS batteries: space-separated "MAC=name[=protocol]" entries. Each is read
# over BLE, sequentially, and published to MQTT topic battery/<name>. The third
# field is optional and overrides the protocol for that battery; omit it to use
# JKBMS_PROTOCOL below. install.sh fills this in (from the JKBMS env var or an
# interactive prompt). Example of a mixed-firmware two-pack setup:
#   JKBMS=AA:BB:CC:DD:EE:01=JKBMS1 AA:BB:CC:DD:EE:02=JKBMS2=JK02
JKBMS=__JKBMS__

# Default jkbms protocol for entries that don't specify one.
# Production uses JK02_32 (newer firmware); older packs use JK02.
JKBMS_PROTOCOL=JK02_32

# Sampling interval in seconds. The collector measures each read and only sleeps
# for the remainder, so the real cadence is max(total_read_time, INTERVAL) and
# reads never overlap. Setting an interval below the read time just makes it loop
# as fast as the hardware allows (with a 1s floor between cycles).
#
# INTERVAL is the shared fallback; the per-service overrides below win and let
# the fast inverter poll quickly while the slow BLE BMS runs at its own pace.
INTERVAL=30
# Inverters: serial reads are fast (~1-2s) -> poll often.
INVERTER_INTERVAL=5
# JK-BMS: BLE reads are slow (~10s per pack, read sequentially). With N packs the
# floor is roughly N*read_time; raising this only slows it further.
JKBMS_INTERVAL=30
# Per-battery read timeout (seconds). A hung BLE read (dead/out-of-range pack) is
# killed after this so it can't stall the loop and block the other batteries.
JKBMS_READ_TIMEOUT=25
# Seconds to pause between batteries so the BLE adapter settles before the next
# connect. A short gap avoids the back-to-back contention that makes the next
# battery's connect fail fast with rc=1. Only matters with 2+ batteries; set 0
# to disable.
JKBMS_SETTLE_DELAY=2

# Inverter detection table: space-separated "power:name" pairs. The collector
# reads AC output active power from the inverter and maps it to a name (used as
# the MQTT topic suffix: inverter/<name>). Add a pair per inverter model.
INVERTER_MAP=2400:easun 3000:sp24

# Optional: force a specific port to a known inverter and skip auto-detection.
# Variable name is INVERTER_<port>. Uncomment/adjust as needed:
#INVERTER_ttyUSB0=easun
#INVERTER_ttyUSB1=sp24

# --- JK *inverter* BMS (PB series) over RS485 serial -------------------------
# Separate from the BLE packs in JKBMS above. The PB-series inverter BMS (e.g.
# the 150A JK-PB2A16S15P v19) exposes its full native data on its RS485-1 port
# (a TRUE differential RS485 interface, not the TTL "GPS" port of the BD units)
# when UART1 is set to protocol "000 - 4G-GPS Common protocol V4.2" in the JK
# app. Wire RS485-1 to a USB-RS485 adapter (A = RJ45 pins 2+7, B = 1+8,
# GND = 3+6) and enable the templated service on that port:
#   systemctl enable --now jkpb-collector@ttyUSB2
# It is read by the dedicated Python collector (native 4E57 protocol, not
# mpp-solar). The CAN port stays free for the inverter link -- RS485 only.
# Data lands on battery/<name>/mpp-solar, i.e. the same Telegraf schema/topic as
# the BLE packs, so battery.conf consumes it unchanged. (16S packs also expose
# voltage_cell09..16, which battery.conf currently excludes -- drop them from its
# excluded_keys if you want all cells in Grafana.)

# MQTT topic suffix -> battery/<name>/mpp-solar. A per-port override JKPB_<port>
# wins (uncomment and adjust for multiple packs / a fixed port).
JKPB_NAME=jkpb
#JKPB_ttyUSB2=pb1

# Serial baud for the native JK protocol. The 4G-GPS/NW protocol is 115200.
JKPB_BAUD=115200

# Fallback rated pack capacity in Ah. The collector reads the real value from
# the BMS frame (register 0xAA) and that ALWAYS wins -- this is only used if the
# firmware doesn't report it. Normally leave it commented out.
#JKPB_CAPACITY_AH=314

# Sampling interval (s) for the RS485 BMS. Reads are fast (~1-2s); 30 is plenty.
JKPB_INTERVAL=30
# Seconds to wait for a complete frame before logging a warning and retrying.
JKPB_READ_TIMEOUT=5

# PATH for the service environment. mpp-solar / jkbms are usually installed by
# `pip install` into /usr/local/bin (system) or ~/.local/bin (user). Adjust if
# `which mpp-solar` on the box shows a different location.
PATH=/usr/local/bin:/usr/bin:/bin
